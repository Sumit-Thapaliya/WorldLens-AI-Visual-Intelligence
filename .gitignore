# ============================
# iOS (if you add it later)
# ============================
mobile/ios/build/
mobile/ios/Pods/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/xcuserdata/
mobile/ios/Podfile.lock
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ============================
# Python
# ============================
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
ai/.venv/
ai/venv/
ai/env/
ai/.env/
ai/build/
ai/dist/
ai/*.egg-info/
ai/.pytest_cache/
ai/.mypy_cache/
ai/.ruff_cache/
.ipynb_checkpoints/

# ============================
# AI / ML generated files (large, can be regenerated)
# ============================
ai/models/converted/*.onnx
ai/models/pretrained/*
!ai/models/pretrained/.gitkeep
!ai/models/converted/.gitkeep
*.pt
*.pth
*.weights
*.tflite
*.ckpt

